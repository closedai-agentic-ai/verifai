{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "src/*",
    "src/services/mobile-mcp.ts",
    "src/services/bedrock.ts",
    "src/utils/promptUtils.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
