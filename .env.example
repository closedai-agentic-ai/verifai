# VerifAI Environment Configuration
# Copy this file to .env and update with your actual values

# API Configuration
API_PORT=3000
API_KEY=your-secure-api-key-here
NODE_ENV=development

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# Android Configuration
ANDROID_HOME=/path/to/android-sdk
ANDROID_SDK_ROOT=/path/to/android-sdk
EMULATOR_NAME=test_emulator_api_30
ADB_PATH=/path/to/android-sdk/platform-tools/adb

# JIRA Configuration
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=bot@your-company.com
JIRA_API_TOKEN=your-jira-api-token

# MCP Configuration
MCP_MOBILE_SERVER_PATH=npx
MCP_JIRA_SERVER_PATH=npx
CLAUDE_CLI_PATH=claude

# File Storage Configuration
TEMP_DIR=./temp
SCREENSHOTS_DIR=./temp/screenshots
APK_DOWNLOAD_DIR=./temp/apks
LOGS_DIR=./logs

# GitHub Configuration
GITHUB_TOKEN=your-github-token-if-needed

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Test Configuration
TEST_TIMEOUT=600000
EMULATOR_STARTUP_TIMEOUT=60000
ELEMENT_WAIT_TIMEOUT=10000
SCREENSHOT_ON_FAILURE=true

# Performance Configuration
MAX_CONCURRENT_TESTS=1
REQUEST_TIMEOUT=30000
RETRY_ATTEMPTS=3
RETRY_DELAY=1000
